COMPOSE_PROJECT_NAME=task01

# PostgreSQL (пароль создаёт scripts/setup-secrets.sh, вручную его заполнять не нужно)
POSTGRES_USER=gitea
POSTGRES_DB=gitea
POSTGRES_PASSWORD=CHANGE_ME

# Домен Gitea (A-запись на IP VPS; обслуживается общим Caddy из common/caddy)
DOMAIN=a1.fdghyt.com
# Имя Gitea в сети edge, на которое проксирует общий Caddy
GITEA_ALIAS=task01-gitea
