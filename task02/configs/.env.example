COMPOSE_PROJECT_NAME=task02

# Образ приложения: только по digest (не по тегу и не latest). Пример — выпуск 83a3acd из RESULT.md;
# при обычном выпуске значения подставляет CI/CD (scripts/ci-deploy.sh)
IMAGE_REF=ghcr.io/nlbeglov/nerp-test-task02@sha256:b764d0dcbe404558bb7330efe8455f4d6be613279592e374f449858d8aa82519
# Значение, которое сервис отдаёт в /version (commit SHA выпуска)
APP_VERSION=83a3acd55071798f0c6dbe84d1a3697f86bd6ed5

# Домен сервиса (A-запись на IP VPS)
DOMAIN=CHANGE_ME
