COMPOSE_PROJECT_NAME=task03

# PostgreSQL (пароль создаёт scripts/setup-secrets.sh, вручную его заполнять не нужно)
POSTGRES_USER=lab
POSTGRES_DB=lab
POSTGRES_PASSWORD=CHANGE_ME

# Домен выдачи тестовых файлов (A-запись на IP VPS)
DOMAIN=CHANGE_ME

# restic: адрес внешнего репозитория на SFTP-хранилище вне VPS
# формат: sftp:ПОЛЬЗОВАТЕЛЬ@ХОСТ:/путь/на/хранилище
# Пароль шифрования репозитория (RESTIC_PASSWORD) здесь не хранится: его создаёт
# scripts/setup-secrets.sh и сохраняет в secrets/credentials.txt (значение передаётся отдельно)
RESTIC_REPOSITORY=CHANGE_ME
